{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-init-coverage",
            "type": "shell",
            "command": [
                "test -d ${config:sdk.dir} && . ${config:sdk.env}; ",
                "cmake  -B${config:build.directory} -GNinja -DCMAKE_BUILD_TYPE=${config:build.type} -DCODE_COVERAGE=ON"
            ]
        },
        {
            "label": "build-init-build-x86",
            "type": "shell",
            "command": [
                "cmake  -B${config:build.directory} -GNinja -DCMAKE_BUILD_TYPE=${config:build.type}"
            ]
        },
        {
            "label": "build-init-build-rpi",
            "type": "shell",
            "command": [
                ". ${config:sdk.env}; ",
                "cmake  -B${config:build.directory} -GNinja -DCMAKE_BUILD_TYPE=${config:build.type}"
            ]
        },
        {
            "label": "build-all",
            "type": "shell",
            "command": [
                "test -d ${config:sdk.dir} && . ${config:sdk.env}; ",
                "cmake  --build ${config:build.directory} --target all"
            ],
            "problemMatcher": {
                "base": "$gcc",
            },
            "group": "build"
        },
        {
