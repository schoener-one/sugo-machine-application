        },
        {
            "label": "build-clean-build",
            "type": "shell",
            "command": "rm -rf ${config:build.directory}"
        },
        // Remote Debugging
        {
            "label": "remote-gdbserver-killall",
            "type": "shell",
            "command": "ssh -o StrictHostKeyChecking=no root@${config:remote.host} -C \"killall gdbserver || true\""
        },
        {
            "label": "remote-upload-MachineApplication",
            "type": "shell",
            "command": "scp -o StrictHostKeyChecking=no \"${config:build.directory}/MachineApplication\" \"root@${config:remote.host}:MachineApplication\""
        },
        {
            "label": "remote-upload-HardwareAbstractionLayerImplTest",
            "type": "shell",
            "command": "scp -o StrictHostKeyChecking=no \"${config:build.directory}/libs/HardwareAbstractionLayerImpl/test/HardwareAbstractionLayerImplTest\" \"root@${config:remote.host}:HardwareAbstractionLayerImplTest\""
        },
        {
            "label": "remote-upload-HardwareConfig",
            "type": "shell",
            "command": [
                "ssh -o StrictHostKeyChecking=no root@${config:remote.host} -C \"mkdir -p HardwareAbstractionLayer/test\";",
                "scp -o StrictHostKeyChecking=no \"${workspaceFolder}/libs/HardwareAbstractionLayerImpl/test/HardwareAbstractionLayerSmokeTestConfig.json\" \"root@${config:remote.host}:HardwareAbstractionLayerSmokeTestConfig.json\""
            ]
        },
        {
            "label": "remote-upload-MachineConfig",
            "type": "shell",
            "command": [
                "ssh -o StrictHostKeyChecking=no root@${config:remote.host} -C \"mkdir -p conf\";",
                "scp -o StrictHostKeyChecking=no \"${workspaceFolder}/conf/MachineConfig.json\" \"root@${config:remote.host}:conf/MachineConfig.json\""
            ]
        },
        {
            "label": "remote-upload-RemoteControlConfig",
            "type": "shell",
            "command": [
                "ssh -o StrictHostKeyChecking=no root@${config:remote.host} -C \"mkdir -p www\";",
                "scp -o StrictHostKeyChecking=no \"${workspaceFolder}/conf/www/index.html\" \"root@${config:remote.host}:www/index.html\""
            ]
        },
        {
            "label": "remote-start-MachineApplication",
            "type": "shell",
            "command": [
                "ssh -o StrictHostKeyChecking=no root@${config:remote.host} -C ",
                "\"/usr/bin/gdbserver localhost:${config:remote.port} MachineApplication --config-file conf/MachineConfig.json\"",
            ],
            "dependsOn": [
                "remote-upload-MachineApplication",
                "remote-upload-MachineConfig",
                "remote-upload-RemoteControlConfig"
            ],
            "dependsOrder": "sequence",
            "isBackground": false
        },
        {
            "label": "remote-start-MachineApplication-direct",
            "type": "shell",
            "command": [
                "ssh -o StrictHostKeyChecking=no root@${config:remote.host} -C ",
                "\"/usr/bin/gdbserver localhost:${config:remote.port} MachineApplication --config-file conf/MachineConfig.json\"",
            ],
            "dependsOrder": "sequence",
            "isBackground": false
        },
        {
            "label": "remote-start-HardwareAbstractionLayerImplTest.GpioControl",
            "type": "shell",
            "command": [
                "ssh -o StrictHostKeyChecking=no root@${config:remote.host} -C ",
                "\"/usr/bin/gdbserver localhost:${config:remote.port} HardwareAbstractionLayerImplTest ",
                "--gtest_filter=HardwareAbstractionLayerSmokeTest.GpioControl\""
            ],
            "dependsOn": [
                "remote-gdbserver-killall",
                "remote-upload-HardwareAbstractionLayerImplTest",
                "remote-upload-HardwareConfig"
            ],
            "dependsOrder": "sequence",
            "isBackground": false
        },
