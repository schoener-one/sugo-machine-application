    "version": "0.2.0",
    "configurations": [
        {
            "name": "Current file",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
        },
        {
            "name": "ServiceComponentGenerator ListOnly",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/libs/ServiceComponent/scripts/GenerateServiceComponents.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "args": ["-i", "${workspaceFolder}/libs/ServiceComponent/test/ServiceComponents.yaml", "-o", "out/ServiceComponent/src-gen", "--list-only"]
        },
        {
            "name": "ServiceComponentGenerator",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/libs/ServiceComponent/scripts/GenerateServiceComponents.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "args": ["-i", "${workspaceFolder}/libs/ServiceComponent/test/ServiceComponents.yaml", "-o", "out/ServiceComponent/src-gen", "--generate-exec-group", "--generate-service-components", "-L", "debug"]
        },
        {
            "name": "ServiceComponentsGenerator (test)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/libs/ServiceComponent/scripts/GenerateServiceComponents.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "args": ["-i", "${workspaceFolder}/libs/ServiceComponent/test/ServiceComponents.yaml", "-o", "out/ServiceComponent/src-gen", "--generate-service-components", "--generate-state-diagrams", "-L", "debug"]
        },
        {
            "name": "ServiceComponentGenerator Templates",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/libs/ServiceComponent/scripts/GenerateServiceComponents.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "args": ["-i", "${workspaceFolder}/libs/ServiceComponent/test/ServiceComponents.yaml", "-o", "out/ServiceComponent/src-gen", "-t"]
        },
        {
            "name": "ServiceComponentGenerator State Diagrams",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/libs/ServiceComponent/scripts/GenerateServiceComponents.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "args": ["-i", "${workspaceFolder}/libs/ServiceComponent/test/ServiceComponents.yaml", "-o", "out/ServiceComponent/src-gen", "--generate-state-diagrams"]
        },
        {
            "name": "Debug HardwareAbstractionLayerImplTest (x86)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${config:build.directory}/libs/HardwareAbstractionLayerImpl/test/HardwareAbstractionLayerImplTest",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb"
        },
        {
            "name": "Debug HardwareAbstractionLayerImplTest (remote)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${config:build.directory}/libs/HardwareAbstractionLayerImpl/test/HardwareAbstractionLayerImplTest",
            "miDebuggerServerAddress": "${config:remote.host}:${config:remote.port}",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "miDebuggerPath": "${config:sdk.dir}/sysroots/x86_64-pokysdk-linux/usr/bin/arm-poky-linux-gnueabi/arm-poky-linux-gnueabi-gdb",
            "MIMode": "gdb",
            "args": [],
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            //"preLaunchTask": "remote-gdbserver-start-HardwareAbstractionLayerImplTest"
        },
        {
            "name": "Debug MachineApplication (remote)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${config:build.directory}/MachineApplication",
            "miDebuggerServerAddress": "${config:remote.host}:${config:remote.port}",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "miDebuggerPath": "${config:sdk.dir}/sysroots/x86_64-pokysdk-linux/usr/bin/arm-poky-linux-gnueabi/arm-poky-linux-gnueabi-gdb",
            "MIMode": "gdb",
            "args": [],
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug Machine Application (x86)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${config:build.directory}/MachineApplication",
            "cwd": "${workspaceFolder}/conf",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "args": ["--config-file", "MachineConfig.json"]
        },
        {
            "name": "Machine Application Integration Test (x86)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${config:build.directory}/test/MachineApplicationIntegrationTest",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "args": []
        },
        {
            "name": "Debug Machine Remote Control Server (x86)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${config:build.directory}/libs/RemoteControl/test/RemoteControlServerSimulator",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "args": ["${workspaceFolder}/conf/www"]
        }
    ]
}